# Global git config for coding agents, selected in ~/.zshenv. Agents sign and authenticate with
# their own passphrase-less key instead of 1Password. One-time setup:
#   ssh-keygen -t ed25519 -N '' -C agent -f ~/.ssh/agent_ed25519
#   gh ssh-key add ~/.ssh/agent_ed25519.pub --type authentication
#   gh ssh-key add ~/.ssh/agent_ed25519.pub --type signing
[include]
	path = ~/.gitconfig

[user]
	signingKey = ~/.ssh/agent_ed25519

[gpg "ssh"]
	program = ssh-keygen

[core]
	# -F /dev/null skips ~/.ssh/config, which sends every host to the 1Password agent.
	sshCommand = ssh -F /dev/null -i ~/.ssh/agent_ed25519 -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes

[url "git@github.com:"]
	insteadOf = https://github.com/
